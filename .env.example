# ---------------------------------------------------------------------------
# Variables de entorno de BarberCita
#
# Copia este archivo a `.env` y reemplaza los valores de ejemplo.
#   cp .env.example .env
#
# Prefijo VITE_  -> público, se incluye en el bundle del cliente. NO pongas
#                   secretos aquí.
# Sin prefijo    -> solo servidor. Nunca se expone al navegador.
# ---------------------------------------------------------------------------

# --- Cliente (público) ------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Servidor (secreto) -----------------------------------------------------
# Solo se usa en el servidor (server functions, scripts de migración).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barbercita

# --- Configuración de Supabase (no son variables de entorno) ----------------
# Authentication -> URL Configuration:
#   Site URL:      http://localhost:3000 (o el dominio público)
#   Redirect URLs: http://localhost:3000/auth/confirmar
#                  https://<tu-dominio>/auth/confirmar
# La app calcula emailRedirectTo con el origen de la petición.
